# APZHUB environment variables (copy to .env — never commit .env)

# Application
NODE_ENV=development
PORT=3300
APP_URL=http://localhost:3300
NEXT_PUBLIC_APP_URL=http://localhost:3300
ALLOW_DEV_REGISTRATION=true
NEXT_PUBLIC_ALLOW_DEV_REGISTRATION=true

# Build / health metadata
PLATFORM_VERSION=0.0.0
BUILD_NUMBER=local

# PostgreSQL (Docker dev — host port 54334)
DATABASE_URL=postgresql://apzhub:apzhub@localhost:54334/apzhub
DATABASE_URL_TEST=postgresql://apzhub:apzhub@localhost:54334/apzhub_test

# Redis (Docker dev — host port 6380)
REDIS_URL=redis://localhost:6380

# Better Auth (generate secrets for local use — do not use these in production)
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-minimum-secret
BETTER_AUTH_URL=http://localhost:3300
# Optional comma-separated extra origins (public host + local coexistence)
# BETTER_AUTH_TRUSTED_ORIGINS=https://apzhub.apzportal.apzor.com,http://localhost:3300,http://127.0.0.1:3300
# Edge middleware self-fetch origin (avoid public HTTPS hairpin / Edge sandbox failures)
# AUTH_INTERNAL_ORIGIN=http://127.0.0.1:3300

# Operator secrets (gitignored) — fill-only into process.env via ensureLocalSecretsLoaded:
#   .secrets/smtp         → SMTP_HOST/PORT/USER/PASS/FROM (+ EMAIL_FROM if unset)
#   .secrets/openai       → OPENAI_API_KEY (raw sk-… line or KEY=value)
#   .secrets/git          → GITHUB_TOKEN / APZHUB_SCM_GITHUB_TOKEN (+ username/login)
#   .secrets/github-app   → GITHUB_APP_ID / GITHUB_APP_INSTALLATION_ID / GITHUB_APP_PRIVATE_KEY
#                           (+ optional APZPEN_GITHUB_WEBHOOK_SECRET)
#   .secrets/github-app.pem → optional PEM-only private key
#   .secrets/meilisearch  → MEILI_MASTER_KEY / SEARCH_MEILISEARCH_API_KEY
# APZHUB_SECRETS_DIR=.secrets
# APZPEN_AI_PROVIDER=auto   # auto | openai | offline
# APZPEN_OPENAI_MODEL=gpt-4o-mini
EMAIL_FROM=noreply@apzhub.local
# SMTP_* / OPENAI_API_KEY / GITHUB_* / MEILI_* are loaded from `.secrets/*` when unset here.

# Law platform persistence (LAW-012-02 — default memory, opt-in postgres)
LAW_REPOSITORY_MODE=memory
ENTITY_MAPPING_STORE_MODE=memory
# ENTITY_MAPPING_ALLOW_MEMORY_IN_PRODUCTION=false
# LAW_TENANT_ID=t0000001-0000-4000-8000-000000000001
# LAW_OUTBOX_ENABLED=true

# Platform service authorisation (OSS-110-06)
# development default: allow-all; production default: production (when unset)
AUTHORIZATION_PROVIDER_MODE=allow-all
# AUTHORIZATION_ALLOW_ALL_IN_PRODUCTION=false

# Search Platform (APZSEARCH-003) — management plane; requires DATABASE_URL
# SEARCH_SERVICE_ENABLED=true
# APZHUB_NOTIFICATION_ENABLED=true
# Search execution (APZSEARCH-006) — requires SEARCH_SERVICE_ENABLED + Meilisearch endpoint
# Compose: infrastructure/docker/docker-compose.dev.yml → host :17700
# SEARCH_EXECUTION_PROVIDER=meilisearch
# SEARCH_MEILISEARCH_ENDPOINT=http://127.0.0.1:17700
# SEARCH_MEILISEARCH_API_KEY_REF=meilisearch/api-key
# SEARCH_MEILISEARCH_API_KEY loaded from `.secrets/meilisearch` when unset
# SEARCH_MEILISEARCH_INDEX_PREFIX=apzhub_
# SEARCH_MEILISEARCH_DEFAULT_INDEX=apzhub_platform
# Platform-1.3-ENG-001 — Search Live Drain (publication journal → Search Integration → optional Meilisearch mirror)
# Deny-by-default. Enable only after migrations 0058/0059 and capacity check.
# APZHUB_SEARCH_ORCHESTRATION_ENABLED=true

# Platform-1.3-ENG-002 — Observe Live Alerts Phase A (ADR-0070)
# Deny-by-default. Missing/invalid values do NOT activate evaluation.
# Allowed: true | 1 | on. Production: enable only after rule inventory + ops readiness.
# APZHUB_OBSERVE_ALERT_EVALUATION_ENABLED=true

# Platform-1.3-ENG-003 — Support Realtime SSE (ADR-0072)
# Deny-by-default. Missing/invalid values do NOT activate SSE streams.
# Allowed: true | 1 | on. Mutations remain REST; SSE is read-only event propagation.
# APZHUB_REALTIME_SSE_ENABLED=true
# Optional capacity / lifecycle (defaults shown):
# APZHUB_REALTIME_MAX_CONNECTIONS_GLOBAL=200
# APZHUB_REALTIME_MAX_CONNECTIONS_PER_TENANT=50
# APZHUB_REALTIME_MAX_QUEUE_PER_CONNECTION=64
# APZHUB_REALTIME_REPLAY_BUFFER_SIZE=100
# APZHUB_REALTIME_IDLE_TIMEOUT_MS=120000
# APZHUB_REALTIME_MAX_CONNECTION_MS=1800000
# APZHUB_REALTIME_DUPLICATE_WINDOW=2000

# Platform notification service + delivery (enable for operational baseline)
# APZHUB_NOTIFICATION_ENABLED=true
# APZHUB_NOTIFICATION_DELIVERY_ENABLED=true
# APZHUB_NOTIFICATION_IN_APP_ENABLED=true
# APZHUB_NOTIFICATION_EMAIL_ENABLED=true
# APZHUB_NOTIFICATION_EVENT_INTAKE_ENABLED=true
# APZHUB_NOTIFICATION_COMMAND_INTAKE_ENABLED=true
# APZHUB_NOTIFICATION_WORKER_ENABLED=true
# SMTP credentials: `.secrets/smtp` only — never commit passwords.
# APZHUB_NOTIFICATION_MAX_ATTEMPTS=5
# APZHUB_NOTIFICATION_RETRY_BASE_DELAY=1000
# APZHUB_NOTIFICATION_RETENTION_DAYS=90
# APZHUB_NOTIFICATION_MAX_QUEUE_DEPTH=10000
# Platform-1.4-ENG-001B-P0 — durable Postgres runtime SoR (ADR-0073). Default OFF.
# Phase 0 introduces the flag only — no claim/worker cut-over when set.
# APZHUB_NOTIFICATION_DURABLE_RUNTIME=true

# Platform HTTP API (OSS-110-07) — uses AUTHORIZATION_* and ENTITY_MAPPING_* above
# Optional Plane provider registration for /api/v1 gateway bootstrap
# PLANE_INTEGRATION_ENABLED=false

# Caddy (optional — when using docker compose Caddy service)
CADDY_HTTP_PORT=3080
CADDY_HTTPS_PORT=3443

# APZ QEP (APZQEP-ENG-010 foundation — no business runtime flags yet)
# QEP packages live in the monorepo; domain programmes add configuration later.
# QEP_PRODUCT_ENABLED=false

# APZQEP-162 — Enterprise Source Control (GitHub provider)
# Default offline (no api.github.com). Set true only with a PAT available.
# Flagship F1 — GitHub Heartbeat (PAT from .secrets/git only; never from browser)
# APZHUB_SCM_GITHUB_LIVE=true
# APZHUB_SCM_GITHUB_WEBHOOK_SECRET=dev-scm-webhook-secret
# Public webhook: POST /api/v1/qep/scm/ingress/github?tenantId=<tenant>
# APZHUB_SCM_DEFAULT_TENANT_ID=t0000001-0000-4000-8000-000000000001
# APZQEP_SCM_PERSISTENCE_MODE=postgres


# Plane integration (OSS-101-02 — disabled by default; internal engine only)
PLANE_INTEGRATION_ENABLED=false
# PLANE_BASE_URL=http://localhost:18085
# PLANE_API_BASE_URL=http://localhost:18085/api
# PLANE_API_TOKEN=change-me-plane-service-token-min-16-chars
# PLANE_WORKSPACE_ID=your-dev-workspace-slug-or-id
# PLANE_WEBHOOK_SECRET=change-me-webhook-secret-min-16-chars

# APZQEP native persistence (Tranche 2) — Cap A–F + siblings
# APZQEP_CORE_QE_PERSISTENCE_MODE=postgres
# APZQEP_AUTOMATION_PERSISTENCE_MODE=postgres
# APZQEP_ORCHESTRATION_PERSISTENCE_MODE=postgres
# APZQEP_DASHBOARD_PERSISTENCE_MODE=postgres
# APZQEP_SCM_PERSISTENCE_MODE=postgres
# APZQEP_QI_PERSISTENCE_MODE=postgres
# Evidence content SoR (ADR-0088): memory | local
# APZQEP_EVIDENCE_STORAGE_PROVIDER=local
# Relative roots resolve from the web process cwd (apps/web in `pnpm --filter @apzhub/web dev`)
# APZQEP_EVIDENCE_STORAGE_ROOT=.data/qep-evidence
# Playwright live automation (Q5) — requires playwright peer + browsers; restart web after change
# APZHUB_AUTOMATION_LIVE=true
# Flagship F9 — auto-start Playwright when a durable SCM change persists (never auto-certifies / auto GO)
# APZHUB_AUTOMATION_ON_CHANGE=true
# Flagship F10 — Option B: dispatch external runners (GitHub Actions / webhook) for domain tools
# APZHUB_VERIFICATION_DISPATCH=true
# APZHUB_VERIFICATION_DISPATCH_MODE=record_only
# Leave MODE unset (not record_only/dry) for live .github/workflows/verify.yml
# APZHUB_VERIFICATION_DISPATCH_OWNER=apzor
# APZHUB_VERIFICATION_DISPATCH_REPO=apzhub-f1-heartbeat
# APZHUB_VERIFICATION_DISPATCH_WORKFLOW=verify.yml
# APZHUB_VERIFICATION_DISPATCH_DOMAINS=vitest,accessibility,security,codequality,k6
# APZHUB_VERIFICATION_DISPATCH_WEBHOOK_URL=
# Flagship F11 — security / pen-test pack dispatch (Trivy/Semgrep/Nuclei/ZAP; Greenbone optional)
# APZHUB_SECURITY_DISPATCH=true
# APZHUB_SECURITY_DISPATCH_MODE=record_only
# Leave MODE unset for live .github/workflows/security.yml
# APZHUB_SECURITY_DISPATCH_OWNER=apzor
# APZHUB_SECURITY_DISPATCH_REPO=apzhub-f1-heartbeat
# APZHUB_SECURITY_DISPATCH_WORKFLOW=security.yml
# APZHUB_SECURITY_DISPATCH_DOMAINS=trivy,semgrep,nuclei,zap
# APZHUB_SECURITY_DISPATCH_WEBHOOK_URL=
# Flagship F16 — produce APZ Projects tasks / Support tickets from QEP defects (default record_only)
# APZHUB_ALM_PRODUCE_MODE=record_only
# APZHUB_ALM_PRODUCE_CHANNELS=projects,support
# APZHUB_ALM_PROJECTS_PROJECT_ID=proj_…
# APZHUB_ALM_SUPPORT_GROUP_ID=sgrp_…
# APZHUB_ALM_SUPPORT_REQUESTER_ID=suser_…
# PayFast (SPR-IAM-COMMERCIAL-001) — never commit live secrets
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_SANDBOX=true
# Flagship hardening — file-backed QEP ledgers under apps/web/.data (off in Vitest; force with =true)
# APZHUB_QEP_LEDGER_PERSIST=true
# APZHUB_QEP_DATA_DIR=/absolute/path/to/.data
# Local usefulness: auto-assign qep-operator on first authz resolve (never enable casually in prod)
# APZQEP_QEP_AUTO_ASSIGN_OPERATOR=true
# APZQEP_QEP_AUTO_ASSIGN_OPERATOR=true

# Demo personas / quick-login on /login (dev & staging)
# ALLOW_DEMO_PERSONAS=true

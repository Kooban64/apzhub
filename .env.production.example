# APZHUB-OPS-002 A3 — Production environment template (Platform 1.2.0)
# Copy to .env.production and replace every CHANGE_ME value.
# NEVER commit .env.production.

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
PORT=3300
# Public URL users and Better Auth will use (must match TLS hostname)
APP_URL=https://CHANGE_ME_HOSTNAME
NEXT_PUBLIC_APP_URL=https://CHANGE_ME_HOSTNAME
ALLOW_DEV_REGISTRATION=false
NEXT_PUBLIC_ALLOW_DEV_REGISTRATION=false
# Self-serve external customer registration (Stream 1 commerce)
ALLOW_SELF_SERVE_REGISTER=false
NEXT_PUBLIC_ALLOW_SELF_SERVE_REGISTER=false

# ── PayFast (commerce checkout) ───────────────────────────────
# Sandbox defaults apply when unset. Set live credentials for production.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# Optional VAT in basis points (e.g. 1500 = 15%)
# COMMERCE_VAT_BPS=1500

# Build / health metadata
PLATFORM_VERSION=1.2.0
BUILD_NUMBER=CHANGE_ME_BUILD

# ── Edge / Caddy ─────────────────────────────────────────────
APZHUB_HOSTNAME=CHANGE_ME_HOSTNAME
APZHUB_ACME_EMAIL=ops@CHANGE_ME_DOMAIN
# Coexistence-safe host ports (defaults). Dedicated public edge may use 80/443.
APZHUB_CADDY_HTTP_HOST_PORT=3080
APZHUB_CADDY_HTTPS_HOST_PORT=3443

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=apzhub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_24_CHARS
POSTGRES_DB=apzhub
APZHUB_POSTGRES_HOST_PORT=54334
# Inside compose, web uses service DNS. For host tools only:
DATABASE_URL=postgresql://apzhub:CHANGE_ME_STRONG_PASSWORD_MIN_24_CHARS@localhost:54334/apzhub

# ── Redis ────────────────────────────────────────────────────
APZHUB_REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380

# ── Better Auth (authentication only) ────────────────────────
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=CHANGE_ME_RANDOM_32_CHAR_MINIMUM_SECRET
BETTER_AUTH_URL=https://CHANGE_ME_HOSTNAME

# ── Authorization (APZHUB-owned permissions) ─────────────────
# MUST be production — never allow-all in production
AUTHORIZATION_PROVIDER_MODE=production
AUTHORIZATION_ALLOW_ALL_IN_PRODUCTION=false

# ── Law / entity mapping persistence ─────────────────────────
LAW_REPOSITORY_MODE=postgres
ENTITY_MAPPING_STORE_MODE=postgres
ENTITY_MAPPING_ALLOW_MEMORY_IN_PRODUCTION=false

# ── Email (noop / SMTP as configured — Email SoR NOT in 1.2.0) ─
EMAIL_FROM=noreply@CHANGE_ME_DOMAIN

# ── Integrations (enable only when engines configured) ───────
PLANE_INTEGRATION_ENABLED=false
# PLANE_BASE_URL=
# PLANE_API_TOKEN=
# ZAMMAD_WEBHOOK_SIGNATURE_TOKEN=

# ── Workflow (MUST remain gated — PL12-KL-09) ────────────────
# Do not enable n8n execute. Deferred intents only.

# ── Search Live Drain (Platform-1.3-ENG-001) ─────────────────
# Enable after journal migrations 0058/0059. Optional Meilisearch mirror uses SEARCH_MEILISEARCH_*.
# APZHUB_SEARCH_ORCHESTRATION_ENABLED=true

# Platform-1.3-ENG-002 — Observe Live Alerts Phase A (ADR-0070)
# Deny-by-default. Do not set true until rule inventory and ops readiness are confirmed.
# APZHUB_OBSERVE_ALERT_EVALUATION_ENABLED=true

# Platform-1.3-ENG-003 — Support Realtime SSE (ADR-0072)
# Deny-by-default. Enable only after capacity/coexistence check.
# APZHUB_REALTIME_SSE_ENABLED=true
# APZHUB_REALTIME_MAX_CONNECTIONS_GLOBAL=200
# APZHUB_REALTIME_MAX_CONNECTIONS_PER_TENANT=50
# APZHUB_REALTIME_MAX_QUEUE_PER_CONNECTION=64
# APZHUB_REALTIME_REPLAY_BUFFER_SIZE=100
# APZHUB_REALTIME_IDLE_TIMEOUT_MS=120000
# APZHUB_REALTIME_MAX_CONNECTION_MS=1800000
# APZHUB_REALTIME_DUPLICATE_WINDOW=2000

# Platform-1.3-ENG-004 — Notification Delivery Phase A (ADR-0071)
# Deny-by-default. SMTP deferred — do not place provider secrets here.
# APZHUB_NOTIFICATION_DELIVERY_ENABLED=true
# APZHUB_NOTIFICATION_IN_APP_ENABLED=true
# APZHUB_NOTIFICATION_EVENT_INTAKE_ENABLED=true
# APZHUB_NOTIFICATION_COMMAND_INTAKE_ENABLED=true
# APZHUB_NOTIFICATION_WORKER_ENABLED=true
# APZHUB_NOTIFICATION_MAX_ATTEMPTS=5
# APZHUB_NOTIFICATION_RETRY_BASE_DELAY=1000
# APZHUB_NOTIFICATION_RETENTION_DAYS=90
# APZHUB_NOTIFICATION_MAX_QUEUE_DEPTH=10000
# Platform-1.4-ENG-001B-P0 — durable Postgres runtime SoR (ADR-0073). Default OFF.
# APZHUB_NOTIFICATION_DURABLE_RUNTIME=true
# SEARCH_MEILISEARCH_ENDPOINT=http://meilisearch:7700
# SEARCH_MEILISEARCH_API_KEY=
# SEARCH_MEILISEARCH_INDEX_PREFIX=apzhub_

# ── Backup ───────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14
APZHUB_BACKUP_HOST_DIR=./infrastructure/backups/postgres

# ── Image ────────────────────────────────────────────────────
APZHUB_WEB_IMAGE=apzhub/web:1.2.0

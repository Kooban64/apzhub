# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/.next-e2e-local/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Operator secrets at repo root (never commit — use deploy/*/secrets/ or host dir + APZHUB_HOST_SECRETS_DIR)
/.secrets/

# Docker stack operator files (examples remain *.example)
deploy/staging/Caddyfile
deploy/production/Caddyfile
deploy/edge/Caddyfile
deploy/staging/secrets/
deploy/production/secrets/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Kimai plugins are separate git clones (not submodules); keep out of this repo index
deploy/vendor-services/vendors/kimai/plugins/ApprovalBundle/
deploy/vendor-services/vendors/kimai/plugins/ArchiveTimesheetsCommandBundle/
deploy/vendor-services/vendors/kimai/plugins/LockdownPerUserBundle/

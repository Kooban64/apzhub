      "@apzhub/qep-test-plans": ["../../packages/qep-test-plans/src/index.ts"],
      "@apzhub/qep-test-plans/presentation": [
        "../../packages/qep-test-plans/src/presentation/index.ts"
      ],
      "@apzhub/qep-test-execution": ["../../packages/qep-test-execution/src/index.ts"],
      "@apzhub/qep-test-execution/domain": [
        "../../packages/qep-test-execution/src/domain/index.ts"
      ],
      "@apzhub/qep-test-execution/application": [
        "../../packages/qep-test-execution/src/application/index.ts"
      ],
      "@apzhub/qep-test-execution/infrastructure": [
        "../../packages/qep-test-execution/src/infrastructure/index.ts"
      ],
      "@apzhub/qep-test-execution/presentation": [
        "../../packages/qep-test-execution/src/presentation/index.ts"
      ],
      "@apzhub/qep-evidence": ["../../packages/qep-evidence/src/index.ts"],
      "@apzhub/qep-evidence/domain": [
        "../../packages/qep-evidence/src/domain/index.ts"
      ],
      "@apzhub/qep-evidence/application": [
        "../../packages/qep-evidence/src/application/index.ts"
      ],
      "@apzhub/qep-evidence/infrastructure": [
        "../../packages/qep-evidence/src/infrastructure/index.ts"
      ],
      "@apzhub/qep-evidence/shared": [
        "../../packages/qep-evidence/src/shared/index.ts"
      ],
      "@apzhub/qep-evidence/api": ["../../packages/qep-evidence/src/api/index.ts"],
      "@apzhub/qep-evidence/presentation": [
        "../../packages/qep-evidence/src/presentation/index.ts"
      ],
      "@apzhub/qep-verification/presentation": [
        "../../packages/qep-verification/src/presentation/index.ts"
      ],
      "@apzhub/qep-traceability/presentation": [
        "../../packages/qep-traceability/src/presentation/index.ts"
      ],
      "@apzhub/platform-orchestration": [
        "../../packages/platform-orchestration/src/index.ts"
      ],
      "@apzhub/platform-scm": ["../../packages/platform-scm/src/index.ts"],
      "@apzhub/qep-scm": ["../../packages/qep-scm/src/index.ts"],
      "@apzhub/qep-scm/presentation": [
        "../../packages/qep-scm/src/presentation/index.ts"
      ],
      "@apzhub/platform-quality-intelligence": [
        "../../packages/platform-quality-intelligence/src/index.ts"
      ],
      "@apzhub/qep-quality-intelligence": [
        "../../packages/qep-quality-intelligence/src/index.ts"
      ],
      "@apzhub/qep-quality-intelligence/presentation": [
        "../../packages/qep-quality-intelligence/src/presentation/index.ts"
      ],
      "@apzhub/platform-dashboard": ["../../packages/platform-dashboard/src/index.ts"],
      "@apzhub/platform-visualization": [
        "../../packages/platform-visualization/src/index.ts"
      ],
      "@apzhub/qep-dashboards": ["../../packages/qep-dashboards/src/index.ts"],
      "@apzhub/qep-dashboards/presentation": [
        "../../packages/qep-dashboards/src/presentation/index.ts"
      ],

      "@apzhub/law-platform/api": ["../law-platform/lib/api/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}

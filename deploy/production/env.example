# Non-secret runtime flags for production. Copy to `.env` next to this compose file.

APZHUB_HOST_SECRETS_DIR=/opt/apzhub/secrets
APZHUB_IMAGE_TAG=production
# On one host with dual edge Caddy: production web is typically `3000` (see `deploy/Caddyfile.dual-host.example`).
APZHUB_WEB_PUBLISH_PORT=3000

POSTGRES_USER=apzhub
POSTGRES_DB=apzhub

NODE_ENV=production

APZHUB_IDENTITY_SOURCE=local
APZHUB_ACCESS_SOURCE=real
APZHUB_PROVISIONING_SOURCE=real
APZHUB_LAUNCH_SOURCE=real
APZHUB_AUDIT_SOURCE=real
APZHUB_PROFILE_SOURCE=real
APZHUB_CATALOG_SOURCE=file

NEXT_PUBLIC_APZHUB_IDENTITY_SOURCE=local
NEXT_PUBLIC_APZHUB_ACCESS_SOURCE=real
NEXT_PUBLIC_APZHUB_LAUNCH_SOURCE=real

# Leave unset in production unless you intentionally treat all entitlements as provisioned
# without worker completion (normally false; use worker + real connectors instead).
# APZHUB_ACCESS_OPTIMISTIC_REALIZATION=false

# Optional: set true in production if silent mock fallback is unacceptable (503 when DB materialization fails).
# APZHUB_ACCESS_STRICT_REAL=true

APZHUB_PROVISIONING_CONNECTOR_PROFILE=simulated

APZHUB_SMTP_PORT=587

APZHUB_LAUNCH_OIDC_USE_INTERNAL_START=true
APZHUB_LAUNCH_OIDC_URL_TEMPLATE=https://idp.example.com/oauth/authorize?client_id=demo&response_type=code&scope=openid&service={service}&{query}&state={state}
NEXT_PUBLIC_APZHUB_LAUNCH_OIDC_URL_TEMPLATE=https://idp.example.com/oauth/authorize?client_id=demo&response_type=code&scope=openid&service={service}&{query}&state={state}
NEXT_PUBLIC_APZHUB_LAUNCH_OIDC_USE_INTERNAL_START=true

APZHUB_PUBLIC_BASE_URL=https://apzportal.apzor.com

APZHUB_AUTH_DEV_LOG_EMAIL_TOKENS=0

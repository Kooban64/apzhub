# Non-secret runtime flags for staging. Copy to `.env` next to this compose file.
# Secret values live only as files under APZHUB_HOST_SECRETS_DIR (mounted at /run/secrets).

APZHUB_HOST_SECRETS_DIR=./secrets
APZHUB_IMAGE_TAG=staging
# On one host with dual edge Caddy: use a **unique** port per stack (see `deploy/Caddyfile.dual-host.example`).
APZHUB_WEB_PUBLISH_PORT=3001

POSTGRES_USER=apzhub
POSTGRES_DB=apzhub

NODE_ENV=production

# Identity / adapters — align server + browser for launch transport.
APZHUB_IDENTITY_SOURCE=local
APZHUB_ACCESS_SOURCE=real
APZHUB_PROVISIONING_SOURCE=real
APZHUB_LAUNCH_SOURCE=real
APZHUB_AUDIT_SOURCE=real
APZHUB_PROFILE_SOURCE=real
APZHUB_CATALOG_SOURCE=file

NEXT_PUBLIC_APZHUB_IDENTITY_SOURCE=local
NEXT_PUBLIC_APZHUB_ACCESS_SOURCE=real
NEXT_PUBLIC_APZHUB_LAUNCH_SOURCE=real

# When access + provisioning are real: set true on staging/local so matrix realization is
# launch-ready without waiting on the provisioning worker. Do NOT use in production if you
# rely on real connector outcomes for gating.
# APZHUB_ACCESS_OPTIMISTIC_REALIZATION=true

# Optional: fail APIs instead of silently serving mock catalog when real access cannot load.
# APZHUB_ACCESS_STRICT_REAL=true

# First production cut: simulated mail/calendar connectors until real integrations are ready.
APZHUB_PROVISIONING_CONNECTOR_PROFILE=simulated

# SMTP port is non-secret; credentials are *_FILE in compose → /run/secrets/*
APZHUB_SMTP_PORT=587

# OIDC launch (set real template for your IdP in staging).
APZHUB_LAUNCH_OIDC_USE_INTERNAL_START=true
APZHUB_LAUNCH_OIDC_URL_TEMPLATE=https://idp.example.com/oauth/authorize?client_id=demo&response_type=code&scope=openid&service={service}&{query}&state={state}
NEXT_PUBLIC_APZHUB_LAUNCH_OIDC_URL_TEMPLATE=https://idp.example.com/oauth/authorize?client_id=demo&response_type=code&scope=openid&service={service}&{query}&state={state}
NEXT_PUBLIC_APZHUB_LAUNCH_OIDC_USE_INTERNAL_START=true

# Public site URL for links in email (password reset, verify-email). Must match how users reach the app.
APZHUB_PUBLIC_BASE_URL=https://staging.apzportal.apzor.com

# Never enable raw token logging outside local dev.
APZHUB_AUTH_DEV_LOG_EMAIL_TOKENS=0

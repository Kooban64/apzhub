# Copy to .env (gitignored) and set strong secrets before bring-up.
KIMAI_PUBLISH_PORT=19083
KIMAI_DB_NAME=kimai
KIMAI_DB_USER=kimai
KIMAI_DB_PASSWORD=change-me-strong-db-password
KIMAI_MYSQL_ROOT_PASSWORD=change-me-strong-root-password
KIMAI_ADMINMAIL=admin@apzhub.local
KIMAI_ADMINPASS=change-me-strong-admin-password
KIMAI_APP_SECRET=change-me-to-a-long-random-secret
# Single backslashes — Symfony regex (do not double-escape)
KIMAI_TRUSTED_HOSTS=127\.0\.0\.1|localhost|kimai
TZ=UTC

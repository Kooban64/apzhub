# Copy to .env (gitignored) and set strong secrets before bring-up.
PAPERLESS_PUBLISH_PORT=19082
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=change-me-strong-db-password
PAPERLESS_SECRET_KEY=change-me-to-a-long-random-secret-key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me-strong-admin-password
PAPERLESS_URL=http://127.0.0.1:19082
PAPERLESS_OCR_LANGUAGE=eng
TZ=UTC

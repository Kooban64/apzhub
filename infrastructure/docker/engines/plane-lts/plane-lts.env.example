# Copy to plane-lts.env (gitignored) and fill secrets before `docker compose up`.
# Never commit plane-lts.env.

PLANE_PUBLISH_HTTP_PORT=19085
WEB_URL=http://127.0.0.1:19085
CORS_ALLOWED_ORIGINS=http://127.0.0.1:19085,http://localhost:19085
APP_DOMAIN=localhost
SITE_ADDRESS=:80

PLANE_POSTGRES_USER=plane
PLANE_POSTGRES_PASSWORD=change-me-plane-db-password
PLANE_POSTGRES_DB=plane

RABBITMQ_USER=plane
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_VHOST=plane

AWS_ACCESS_KEY_ID=apzhub-plane-minio
AWS_SECRET_ACCESS_KEY=change-me-minio-secret-key
AWS_S3_BUCKET_NAME=uploads

SECRET_KEY=change-me-plane-django-secret-key-min-32-chars
LIVE_SERVER_SECRET_KEY=change-me-plane-live-secret

GUNICORN_WORKERS=1
DEBUG=0

{
  "name": "apzhub",
  "version": "0.1.0-foundation",
  "private": true,
  "description": "APZHUB \u2014 Enterprise Operating Platform",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @apzhub/web dev",
    "dev:law": "pnpm --filter @apzhub/law-platform dev",
    "build": "pnpm --filter @apzhub/web build",
    "build:law": "pnpm --filter @apzhub/law-platform build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config testing/playwright/playwright.config.ts",
    "test:e2e:law": "playwright test --config testing/playwright/playwright.law.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006 -c packages/ui/.storybook",
    "build-storybook": "storybook build -c packages/ui/.storybook",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.dev.yml down",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.dev.yml logs -f",
    "db:generate": "pnpm --filter @apzhub/config db:generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:reset": "pnpm db:migrate && pnpm db:seed",
    "openapi:validate": "npx @apidevtools/swagger-cli validate docs/specs/LAW-OpenAPI-v1.yaml",
    "openapi:validate:platform": "npx @apidevtools/swagger-cli validate docs/specs/APZHUB-Platform-OpenAPI-v1.yaml",
    "audit:reporting-vertical": "node scripts/apzreport-003-reporting-vertical-audit.mjs",
    "audit:document-foundation": "node scripts/apzdocs-001-document-foundation-audit.mjs",
    "audit:document-vertical": "node scripts/apzdocs-006-document-vertical-audit.mjs",
    "audit:search-foundation": "node scripts/apzsearch-001-search-foundation-audit.mjs",
    "audit:workflow-foundation": "node scripts/apzworkflow-001-workflow-foundation-audit.mjs",
    "audit:notification-foundation": "node scripts/apznotify-001-notification-foundation-audit.mjs",
    "audit:notification-platform-services": "node scripts/apznotify-002-platform-services-audit.mjs",
    "audit:notification-http-client": "node scripts/apznotify-003-notification-http-audit.mjs",
    "audit:notification-workbench": "node scripts/apznotify-004-notification-workbench-audit.mjs",
    "audit:notification-vertical": "node scripts/apznotify-005-notification-vertical-audit.mjs",
    "audit:notification-wave": "node scripts/apznotify-006-notification-wave-closeout-audit.mjs",
    "audit:admin-foundation": "node scripts/apzadmin-001-administration-foundation-audit.mjs",
    "audit:identity-foundation": "node scripts/apzidentity-001-identity-foundation-audit.mjs",
    "audit:observe-foundation": "node scripts/apzobserve-001-observe-foundation-audit.mjs",
    "audit:observe-platform-services": "node scripts/apzobserve-002-platform-services-audit.mjs",
    "audit:observe-http-client": "node scripts/apzobserve-003-observe-http-audit.mjs",
    "audit:observe-workbench": "node scripts/apzobserve-004-observe-workbench-audit.mjs",
    "audit:observe-vertical": "node scripts/apzobserve-005-observe-vertical-audit.mjs",
    "certify:observe-vertical": "node scripts/apzobserve-005-certify-observe-vertical.mjs",
    "audit:observe-wave": "node scripts/apzobserve-006-observe-wave-closeout-audit.mjs",
    "audit:administration-platform-services": "node scripts/apzadmin-002-platform-services-audit.mjs",
    "audit:identity-platform-services": "node scripts/apzidentity-002-platform-services-audit.mjs",
    "audit:administration-vertical": "node scripts/apzadmin-005-administration-vertical-audit.mjs",
    "audit:administration-wave": "node scripts/apzadmin-006-administration-wave-closeout-audit.mjs",
    "audit:configuration-foundation": "node scripts/apzconfig-001-configuration-foundation-audit.mjs",
    "audit:configuration-platform-services": "node scripts/apzconfig-002-platform-services-audit.mjs",
    "audit:configuration-http-client": "node scripts/apzconfig-003-configuration-http-audit.mjs",
    "audit:configuration-workbench": "node scripts/apzconfig-004-configuration-workbench-audit.mjs",
    "audit:configuration-vertical": "node scripts/apzconfig-005-configuration-vertical-audit.mjs",
    "audit:configuration-wave": "node scripts/apzconfig-006-configuration-wave-closeout-audit.mjs",
    "audit:workflow-platform-services": "node scripts/apzworkflow-002-platform-services-audit.mjs",
    "audit:workflow-http-client": "node scripts/apzworkflow-003-workflow-http-audit.mjs",
    "audit:workflow-workbench": "node scripts/apzworkflow-004-workflow-workbench-audit.mjs",
    "audit:workflow-vertical": "node scripts/apzworkflow-005-workflow-vertical-audit.mjs",
    "audit:n8n-adapter": "node scripts/apzworkflow-006-n8n-adapter-audit.mjs",
    "audit:workflow-n8n-adapter": "node scripts/apzworkflow-006-n8n-adapter-audit.mjs",
    "audit:workflow-n8n-platform-services": "node scripts/apzworkflow-007-n8n-platform-services-audit.mjs",
    "audit:workflow-engine-http": "node scripts/apzworkflow-008-workflow-engine-http-audit.mjs",
    "audit:workflow-engine-workbench": "node scripts/apzworkflow-009-workflow-engine-workbench-audit.mjs",
    "audit:workflow-engine-vertical": "node scripts/apzworkflow-010-workflow-engine-vertical-audit.mjs",
    "audit:workflow-engine-wave": "node scripts/apzworkflow-011-workflow-engine-wave-closeout-audit.mjs",
    "audit:search-persistence": "node scripts/apzsearch-002-search-persistence-audit.mjs",
    "audit:search-platform-services": "node scripts/apzsearch-003-platform-services-audit.mjs",
    "audit:search-integration-sdk": "node scripts/apzsearch-004-search-integration-sdk-audit.mjs",
    "audit:meilisearch-adapter": "node scripts/apzsearch-005-meilisearch-adapter-audit.mjs",
    "audit:search-execution": "node scripts/apzsearch-006-search-execution-audit.mjs",
    "audit:search-http": "node scripts/apzsearch-007-search-http-audit.mjs",
    "audit:search-workbench": "node scripts/apzsearch-007-search-workbench-audit.mjs",
    "audit:search-vertical": "node scripts/apzsearch-008-search-vertical-audit.mjs",
    "audit:search-integration": "node scripts/apzsearch-009-search-integration-audit.mjs",
    "audit:search-projects": "node scripts/apzsearch-010-search-projects-audit.mjs",
    "audit:search-support": "node scripts/apzsearch-011-search-support-audit.mjs",
    "audit:search-documents": "node scripts/apzsearch-012-search-documents-audit.mjs",
    "audit:search-testing": "node scripts/apzsearch-013-search-testing-audit.mjs",
    "audit:search-reporting": "node scripts/apzsearch-014-search-reporting-audit.mjs",
    "audit:search-publication": "node scripts/apzsearch-015-search-publication-audit.mjs",
    "openapi:postman": "node scripts/generate-law-postman-collection.mjs",
    "openapi:bruno": "node scripts/generate-law-bruno-collection.mjs",
    "openapi:collections": "pnpm openapi:postman && pnpm openapi:bruno",
    "prepare": "husky",
    "audit:administration-http-client": "node scripts/apzadmin-003-administration-http-audit.mjs",
    "audit:administration-workbench": "node scripts/apzadmin-004-administration-workbench-audit.mjs",
    "audit:identity-http-client": "node scripts/apzidentity-003-identity-http-audit.mjs",
    "audit:identity-workbench": "node scripts/apzidentity-004-identity-workbench-audit.mjs",
    "audit:identity-vertical": "node scripts/apzidentity-005-identity-vertical-audit.mjs",
    "certify:identity-vertical": "node scripts/apzidentity-005-certify-identity-vertical.mjs",
    "audit:identity-wave": "node scripts/apzidentity-006-identity-wave-closeout-audit.mjs"
  },

  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.53.1",
    "@storybook/addon-a11y": "^9.0.13",
    "@storybook/addon-docs": "^9.0.13",
    "@storybook/react-vite": "^9.0.13",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@axe-core/playwright": "^4.10.2",
    "dotenv": "^16.5.0",
    "eslint": "^9.28.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^9.0.13",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,json,md,css,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix"
    ]
  }
}

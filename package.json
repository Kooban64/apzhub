{
  "name": "apzhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:stabilization": "npm run typecheck && npm run verify:catalog-max && npm run verify:preflight && npm test && npx playwright test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-local-identity.ts",
    "db:seed:hub-demo": "tsx scripts/seed-hub-demo-users.ts",
    "db:seed:apzor-testing": "tsx scripts/seed-apzor-testing-users.ts",
    "verify:catalog-max": "tsx scripts/verify-catalog-max-access.ts",
    "verify:preflight": "tsx scripts/preflight-apzhub-env.ts",
    "db:import-legacy-users": "tsx scripts/import-legacy-vendor-users-to-portal.ts",
    "db:seed:provisioning": "tsx scripts/seed-provisioning-engine.ts",
    "worker:provisioning": "tsx scripts/provisioning-worker.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
